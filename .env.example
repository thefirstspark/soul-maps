# Soul Map Webhook Server Environment Variables
# Copy this to .env and fill in your values

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Scopes needed: repo (all), read:user
# Format: ghp_XXXXXXXXXXXX...
GITHUB_PAT=

# Resend API key (for confirmation + monthly update emails)
# Create at: https://resend.com/api-keys
# Format: re_XXXXXXXXXXXX...
RESEND_API_KEY=

# From address for outgoing emails (must be on a Resend-verified domain)
# Default: "The First Spark <hello@thefirstspark.shop>"
RESEND_FROM=

# --- POST /generate protection ---
# Shared secret required on every generate request (header X-Soul-Map-Key).
# Put the SAME value in success.html:
#   <meta name="soul-map-generate-key" content="YOUR_KEY_HERE">
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
GENERATE_API_KEY=

# Local only: allow /generate without a key (never set in Railway production)
ALLOW_INSECURE_GENERATE=0

# Rate limits (per sliding window)
GENERATE_RATE_LIMIT_IP=8
GENERATE_RATE_LIMIT_EMAIL=3
GENERATE_RATE_WINDOW_SEC=900

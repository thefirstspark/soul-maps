# Soul Map Webhook Server Environment Variables
# Copy this to .env and fill in your values

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Scopes needed: repo (all), read:user
# Format: ghp_XXXXXXXXXXXX...
GITHUB_PAT=

# Gmail SMTP Configuration (optional, for email confirmations)
# Email address to send from
SMTP_EMAIL=

# Gmail App Password (NOT your regular password)
# Create at: https://myaccount.google.com/apppasswords
# This requires 2FA to be enabled on your Google account
SMTP_PASSWORD=
